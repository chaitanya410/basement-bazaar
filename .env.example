# Copy to .env and fill in. Never commit .env.
#
# Both values are safe to expose in the browser bundle: the anon key is
# public by design and Row Level Security is what actually protects data.
# Find them in Supabase under Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used ONLY by scripts/import-members.mjs, run locally. Never expose this in
# the frontend or commit it — it bypasses Row Level Security entirely.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
